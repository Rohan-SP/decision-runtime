# Status: draft / pending owner review.
IMAGE_TAG=local
MODEL_CONFIGURATION_ID=decider_2b_bfloat16_safetensors
# none for Safetensors, cpu for local GGUF, cuda for a CUDA GGUF image.
GGUF_BACKEND=none
GGUF_CONTEXT_TOKENS=4096
GGUF_BATCH_TOKENS=64

# KJL: This relative path remains valid while both repos are siblings under
# neurorium-system. Update it if either folder name or the layout changes.
MODELS_MOUNT="../neurorium/model_runtime/models"
PREFIX_CACHES_MOUNT="./data/prefix_caches"
LOGGING_MOUNT="./data/logs"

# Force CPU for laptop development; use auto/cuda with a GPU budget on the GPU PC.
DEVICE=cpu
GPU_MEMORY_BUDGET_GB=
